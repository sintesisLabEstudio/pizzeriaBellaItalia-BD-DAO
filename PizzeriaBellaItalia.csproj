<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <!-- <PackageReference Include="System.Data.SqlClient" Version="4.9.1" /> (no se usa por el momento; se unifica en Microsoft.Data.SqlClient) -->
  </ItemGroup>

  <ItemGroup>
    <!-- La carpeta BDpizzeria\pruebaDao es un proyecto de pruebas aparte:
         no se compila junto con la aplicación WinForms. -->
    <Compile Remove="BDpizzeria\pruebaDao\**" />
    <None Remove="BDpizzeria\pruebaDao\**" />
    <EmbeddedResource Remove="BDpizzeria\pruebaDao\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>